# Radxa Rock 5 ITX (RK3588) — 板级内核配置片段
# 通过 BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES 叠加在 kernel-arm64-rockchip.config 之上
# TODO: 以下符号名请对照内核 6.18.52 实际 Kconfig 校验

# 板载 3.5mm 音频走 ES8316 codec（Armbian rock-5-itx.conf 指定 es8316-sound 声卡）
CONFIG_SND_SOC_ES8316=y

# RK3588 SoC 侧音频（I2S/TDM/HDMI/DP 声卡）通常已在基础配置开启；
# 若 3.5mm 无声，确认以下被启用：
#   CONFIG_SND_SOC_ROCKCHIP_I2S_TDM=y
#   CONFIG_SND_SOC_ROCKCHIP_MULTIPLE_CODEC=y
#   CONFIG_SND_SOC_HDMI_CODEC=y

# NVMe / 2.5GbE(r8169) / USB / 板载 WiFi(AP6275P 等) 等由基础配置覆盖，无需在此重复
